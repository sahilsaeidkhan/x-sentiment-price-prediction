# Copy to .env and fill in your own free-tier tokens. NEVER commit .env.
# Apify — used by src/apify_ingest.py to scrape X (Twitter) posts.
APIFY_API_TOKEN=
# X scraper actor on Apify (default below is set in src/config.py).
APIFY_ACTOR_ID=kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
# Tavily — used by src/news_ingest.py for recent news. RSS fallback works without it.
TAVILY_API_KEY=
# Exa — optional alternative news/search source named in the assignment.
EXA_API_KEY=
